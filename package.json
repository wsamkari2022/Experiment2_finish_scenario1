{
  "name": "template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "validate:block5": "node tools/validate_block5.cjs && node tools/validate_block5_metrics.mjs && npm run validate:vci && npm run validate:stability && npm run validate:lenses && npm run validate:people && npm run validate:position && npm run verify:apa && npm run test:planner",
    "check:images": "node tools/check_scenario_images.mjs",
    "validate:metrics": "node tools/validate_block5_metrics.mjs",
    "validate:vci": "tsc -p tools/tsconfig.sim.json && node tools/simulate_vci.cjs",
    "validate:stability": "tsc -p tools/tsconfig.sim.json && node tools/simulate_stability.cjs",
    "validate:lenses": "tsc -p tools/tsconfig.sim.json && node tools/validate_cvr_lenses.cjs",
    "validate:people": "node tools/validate_cvr_people.mjs",
    "print:stories": "tsc -p tools/tsconfig.sim.json && node tools/print_stories.cjs",
    "pdf:stories": "tsc -p tools/tsconfig.sim.json && node tools/make_story_pdf.mjs",
    "test:planner": "tsc -p tools/tsconfig.sim.json && node tools/test_planner.cjs",
    "validate:position": "tsc -p tools/tsconfig.sim.json && node tools/simulate_position.cjs",
    "verify:apa": "tsc -p tools/tsconfig.sim.json && node tools/verify_apa.cjs",
    "apa:personas": "tsc -p tools/tsconfig.sim.json && node tools/apa_personas.cjs",
    "apa:walkthrough": "tsc -p tools/tsconfig.sim.json && node tools/apa_walkthrough.cjs",
    "apa:variants": "tsc -p tools/tsconfig.sim.json && node tools/apa_context_variants.cjs",
    "validate:planner": "tsc -p tools/tsconfig.sim.json && node tools/simulate_planner.cjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.33.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
