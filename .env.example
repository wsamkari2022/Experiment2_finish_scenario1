# ---------------------------------------------------------------------------
# Experiment 2 - server settings (template)
#
# On the SERVER, inside the project folder:
#     cp .env.example .env
#     nano .env          # put the real password in MONGO_URL
#     chmod 600 .env     # only your user can read it
#
# The real .env holds the database password. Never commit it, never email it,
# and do not copy it back to your laptop. .gitignore already excludes it.
# ---------------------------------------------------------------------------

# MongoDB running on the same server. The app connects directly to
# 127.0.0.1:27017 - no SSH tunnel is involved on the server itself.
#
# Password rule: use letters and digits only (no @ : / ? # [ ] %), or the URL
# breaks. A safe way to generate one on the server:  openssl rand -hex 24
MONGO_URL=mongodb://vrds2_user:CHANGE_ME@127.0.0.1:27017/VRDS2?authSource=admin

# The database the study writes to. Required - build-and-run.sh refuses to
# start without it, so data can never land in the wrong database by accident.
MONGO_DB=VRDS2
